#!/bin/sh
# Validate commit message follows Conventional Commits
# Matches the default type set used by commitlint (config-conventional)
# and amannn/action-semantic-pull-request in CI.

commit_msg=$(head -1 "$1")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?!?: .+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Commit message does not follow Conventional Commits."
  echo ""
  echo "   Format: <type>(optional-scope): <description>"
  echo "   Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo ""
  echo "   Examples:"
  echo "     feat: add duplicate stoq check"
  echo "     fix(PROJ-123): stop dropping profile edits"
  echo ""
  echo "   Your message: $commit_msg"
  exit 1
fi
